#!/bin/sh
# Synaptics Prometheus 06cb:009b sleep hook
# Releases device before suspend and restarts fprintd upon resume.

case "$1/$2" in
pre/*)
	systemctl stop fprintd.service 2>/dev/null || true
	;;
post/*)
	# If fprintd is not active upon resume, start it once cleanly without sleep delays
	if ! systemctl is-active --quiet fprintd.service; then
		systemctl start fprintd.service 2>/dev/null || true
	fi
	;;
esac
