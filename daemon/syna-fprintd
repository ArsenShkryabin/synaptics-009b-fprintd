#!/usr/bin/env python3
"""
syna-fprintd — Drop-in net.reactivated.Fprint D-Bus daemon for Synaptics Prometheus (06cb:009b).
Provides standard Fprint Manager and Device interfaces for fprintd-enroll, fprintd-verify, and pam_fprintd.
"""

import sys
import os
import pwd
import shutil
import signal
import subprocess
import threading
import logging

import dbus
import dbus.service
import dbus.mainloop.glib
from gi.repository import GLib

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s",
    handlers=[logging.StreamHandler(sys.stdout)]
)

dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)

BUS_NAME = "net.reactivated.Fprint"
MANAGER_PATH = "/net/reactivated/Fprint/Manager"
DEVICE_PATH = "/net/reactivated/Fprint/Device/0"
MANAGER_INTERFACE = "net.reactivated.Fprint.Manager"
DEVICE_INTERFACE = "net.reactivated.Fprint.Device"

# Resolve the helper at runtime so both `install.sh` (/usr/local/bin) and the
# AUR package (/usr/bin) work.  An explicit SYNA_TOOL env var still wins.
SYNA_TOOL = (
    os.environ.get("SYNA_TOOL")
    or shutil.which("syna-tool")
    or "/usr/local/bin/syna-tool"
)

# The daemon runs as root and creates/replaces template files.  Never let a
# template or a temp file become world-readable, even if the caller's umask is
# 022.  Subprocesses (syna-tool) inherit this.
os.umask(0o077)

class NoSuchDevice(dbus.DBusException):
    _dbus_error_name = "net.reactivated.Fprint.Error.NoSuchDevice"

class AlreadyInUse(dbus.DBusException):
    _dbus_error_name = "net.reactivated.Fprint.Error.AlreadyInUse"

class ClaimDevice(dbus.DBusException):
    _dbus_error_name = "net.reactivated.Fprint.Error.ClaimDevice"

class PermissionDenied(dbus.DBusException):
    _dbus_error_name = "net.reactivated.Fprint.Error.PermissionDenied"

class NoEnrolledPrints(dbus.DBusException):
    _dbus_error_name = "net.reactivated.Fprint.Error.NoEnrolledPrints"


class FprintDevice(dbus.service.Object):
    def __init__(self, bus_name):
        super().__init__(bus_name, DEVICE_PATH)
        self.bus_name = bus_name
        self.claimed_by = None
        self.claim_sender = None
        self.active_proc = None
        self.worker_thread = None
        self.stop_requested = False
        self.operation_done = True

        self._properties = {
            "name": dbus.String("Synaptics Prometheus (06cb:009b)"),
            "num-enroll-stages": dbus.Int32(5),
            "scan-type": dbus.String("press"),
            "finger-present": dbus.Boolean(False),
            "finger-needed": dbus.Boolean(False)
        }

        try:
            bus_name.get_bus().add_signal_receiver(
                self._on_name_owner_changed,
                signal_name="NameOwnerChanged",
                dbus_interface="org.freedesktop.DBus"
            )
        except Exception as e:
            logging.warning(f"Failed to subscribe to NameOwnerChanged: {e}")

    def _on_name_owner_changed(self, name, old_owner, new_owner):
        if self.claim_sender and name == self.claim_sender and not new_owner:
            logging.info(f"Claimant {name} disconnected from bus, auto-releasing")
            self._stop_current_operation()
            self.claimed_by = None
            self.claim_sender = None

    # --- caller authorization -------------------------------------------------
    #
    # The system-bus policy lets every local user call this service, exactly
    # like the real fprintd.  Authorization must therefore happen here, not in
    # the bus policy.  All user-facing methods take the D-Bus `sender` and
    # resolve it to a UID; the caller may only act for its own account (root
    # may act for any account, which is what pam_fprintd needs under sudo).
    def _caller_pw(self, sender):
        if not sender:
            raise PermissionDenied("missing D-Bus sender")
        try:
            uid = int(self.connection.get_unix_user(sender))
        except Exception as e:
            logging.warning("cannot resolve D-Bus sender %s: %s", sender, e)
            raise PermissionDenied("cannot resolve caller identity")
        try:
            return pwd.getpwuid(uid)
        except KeyError:
            raise PermissionDenied(f"caller UID {uid} has no passwd entry")

    def _resolve_user(self, username, sender):
        """Return the target passwd entry; only self or root may be targeted."""
        caller = self._caller_pw(sender)
        if not username:
            return caller
        try:
            target = pwd.getpwnam(username)
        except KeyError:
            raise PermissionDenied(f"unknown user {username!r}")
        if caller.pw_uid != 0 and target.pw_uid != caller.pw_uid:
            logging.warning(
                "permission denied: uid %d (%s) tried to act for %s (uid %d)",
                caller.pw_uid,
                caller.pw_name,
                target.pw_name,
                target.pw_uid,
            )
            raise PermissionDenied("caller may only act for its own user")
        return target

    def _require_claim(self, sender):
        """Return the claimed username, requiring *this* sender to own the claim."""
        if not self.claimed_by or not self.claim_sender:
            raise ClaimDevice()
        caller = self._caller_pw(sender)
        if caller.pw_uid != 0 and sender != self.claim_sender:
            raise PermissionDenied("device is claimed by another caller")
        return self.claimed_by

    def _require_claimant_for_stop(self, sender):
        """Stop/release: root or the claimant; no claim is a harmless no-op."""
        if not self.claimed_by or not self.claim_sender:
            return
        caller = self._caller_pw(sender)
        if caller.pw_uid != 0 and sender != self.claim_sender:
            raise PermissionDenied("only the claimant may stop this operation")

    def _list_fingers(self, username, sender):
        target = self._resolve_user(username, sender)
        try:
            res = subprocess.run(
                [SYNA_TOOL, "list", str(target.pw_uid)],
                capture_output=True,
                text=True,
                check=True,
            )
            fingers = [f.strip() for f in res.stdout.strip().splitlines() if f.strip()]
            logging.info("Found enrolled fingers for %s: %s", target.pw_name, fingers)
            return fingers
        except Exception as e:
            logging.error("Error listing fingers for %s: %s", target.pw_name, e)
            return []

    # --- org.freedesktop.DBus.Properties ---
    @dbus.service.method(dbus_interface=dbus.PROPERTIES_IFACE, in_signature="ss", out_signature="v")
    def Get(self, interface_name, property_name):
        if interface_name != DEVICE_INTERFACE:
            raise dbus.exceptions.DBusException(f"Unknown interface {interface_name}")
        if property_name not in self._properties:
            raise dbus.exceptions.DBusException(f"Unknown property {property_name}")
        return self._properties[property_name]

    @dbus.service.method(dbus_interface=dbus.PROPERTIES_IFACE, in_signature="s", out_signature="a{sv}")
    def GetAll(self, interface_name):
        if interface_name != DEVICE_INTERFACE:
            raise dbus.exceptions.DBusException(f"Unknown interface {interface_name}")
        return self._properties

    # --- Signals ---
    @dbus.service.signal(dbus_interface=DEVICE_INTERFACE, signature="sb")
    def EnrollStatus(self, result, done):
        logging.info(f"Signal: EnrollStatus({result}, {done})")

    @dbus.service.signal(dbus_interface=DEVICE_INTERFACE, signature="sb")
    def VerifyStatus(self, result, done):
        logging.info(f"Signal: VerifyStatus({result}, {done})")

    @dbus.service.signal(dbus_interface=DEVICE_INTERFACE, signature="s")
    def VerifyFingerSelected(self, finger_name):
        logging.info(f"Signal: VerifyFingerSelected({finger_name})")

    @dbus.service.signal(dbus_interface=DEVICE_INTERFACE, signature="s")
    def VerifyFingerMatched(self, finger_name):
        logging.info(f"Signal: VerifyFingerMatched({finger_name})")

    # --- Methods ---
    @dbus.service.method(dbus_interface=DEVICE_INTERFACE, in_signature="s", out_signature="",
                         sender_keyword="sender")
    def Claim(self, username, sender=None):
        caller = self._resolve_user(username, sender)
        logging.info(
            "Claim by %s (uid %d, sender %s)",
            caller.pw_name,
            caller.pw_uid,
            sender,
        )
        if self.claimed_by is not None and self.claim_sender != sender:
            try:
                self.connection.get_unix_user(self.claim_sender)
            except Exception:
                logging.info(f"Previous claimant {self.claim_sender} is gone, auto-releasing")
                self._stop_current_operation()
                self.claimed_by = None
                self.claim_sender = None
            if self.claimed_by is not None and self.claim_sender != sender:
                raise AlreadyInUse()
        self.claimed_by = caller.pw_name
        self.claim_sender = sender

    @dbus.service.method(dbus_interface=DEVICE_INTERFACE, in_signature="", out_signature="",
                         sender_keyword="sender")
    def Release(self, sender=None):
        logging.info(f"Release by {sender}")
        self._require_claimant_for_stop(sender)
        self._stop_current_operation()
        self.claimed_by = None
        self.claim_sender = None

    @dbus.service.method(dbus_interface=DEVICE_INTERFACE, in_signature="s", out_signature="as",
                         sender_keyword="sender")
    def ListEnrolledFingers(self, username, sender=None):
        logging.info(f"ListEnrolledFingers for {username} (sender {sender})")
        return self._list_fingers(username, sender)

    @dbus.service.method(dbus_interface=DEVICE_INTERFACE, in_signature="s", out_signature="",
                         sender_keyword="sender")
    def DeleteEnrolledFingers(self, username, sender=None):
        target = self._resolve_user(username, sender)
        logging.info("DeleteEnrolledFingers for %s (uid %d)", target.pw_name, target.pw_uid)
        if self.claimed_by is not None and sender != self.claim_sender:
            caller = self._caller_pw(sender)
            if caller.pw_uid != 0:
                raise PermissionDenied("device is claimed by another caller")
        subprocess.run([SYNA_TOOL, "delete", str(target.pw_uid)], check=False)

    @dbus.service.method(dbus_interface=DEVICE_INTERFACE, in_signature="", out_signature="",
                         sender_keyword="sender")
    def DeleteEnrolledFingers2(self, sender=None):
        logging.info(f"DeleteEnrolledFingers2 (sender {sender})")
        if self.claimed_by:
            username = self._require_claim(sender)
        else:
            username = self._caller_pw(sender).pw_name
        target = self._resolve_user(username, sender)
        subprocess.run([SYNA_TOOL, "delete", str(target.pw_uid)], check=False)

    @dbus.service.method(dbus_interface=DEVICE_INTERFACE, in_signature="s", out_signature="",
                         sender_keyword="sender")
    def DeleteEnrolledFinger(self, finger_name, sender=None):
        logging.info(f"DeleteEnrolledFinger {finger_name} (sender {sender})")
        if self.claimed_by:
            username = self._require_claim(sender)
        else:
            username = self._caller_pw(sender).pw_name
        target = self._resolve_user(username, sender)
        subprocess.run(
            [SYNA_TOOL, "delete", str(target.pw_uid), finger_name],
            check=False,
        )

    def _stop_current_operation(self):
        self.stop_requested = True
        if self.active_proc and self.active_proc.poll() is None:
            logging.info("Stopping active syna-tool process")
            self.active_proc.terminate()
            try:
                self.active_proc.wait(timeout=1.0)
            except subprocess.TimeoutExpired:
                logging.warning("syna-tool did not exit cleanly on SIGTERM, killing...")
                self.active_proc.kill()
                try:
                    self.active_proc.wait(timeout=0.5)
                except subprocess.TimeoutExpired:
                    pass
        self.active_proc = None

    @dbus.service.method(dbus_interface=DEVICE_INTERFACE, in_signature="s", out_signature="",
                         sender_keyword="sender")
    def EnrollStart(self, finger_name, sender=None):
        logging.info(f"EnrollStart for finger: {finger_name} (sender {sender})")
        username = self._require_claim(sender)
        target = self._resolve_user(username, sender)
        uid = target.pw_uid

        self._stop_current_operation()
        self.stop_requested = False
        self.operation_done = False

        def worker():
            try:
                if self.stop_requested:
                    return
                proc = subprocess.Popen(
                    [SYNA_TOOL, "enroll", str(uid), finger_name],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True,
                    bufsize=1
                )
                self.active_proc = proc
                if self.stop_requested:
                    proc.terminate()
                    return

                stderr_lines = []
                def read_stderr():
                    try:
                        for eline in proc.stderr:
                            stderr_lines.append(eline)
                    except Exception:
                        pass
                t_err = threading.Thread(target=read_stderr, daemon=True)
                t_err.start()

                done_result = None
                for line in proc.stdout:
                    if self.stop_requested:
                        break
                    line = line.strip()
                    logging.info(f"syna-tool: {line}")
                    if line.startswith("PROGRESS:"):
                        parts = line.split(":")
                        stage_result = parts[1]
                        GLib.idle_add(self.EnrollStatus, stage_result, False)
                    elif line.startswith("DONE:"):
                        done_result = line.split(":")[1]
                        break

                proc.wait()
                t_err.join(timeout=0.5)
                err = "".join(stderr_lines).strip()
                if err:
                    logging.info(f"syna-tool stderr: {err}")

                if not self.stop_requested and not self.operation_done:
                    self.operation_done = True
                    GLib.idle_add(
                        self.EnrollStatus,
                        done_result or "enroll-failed",
                        True,
                    )
            except Exception as e:
                logging.error(f"Enrollment worker error: {e}")
                if not self.operation_done:
                    self.operation_done = True
                    GLib.idle_add(self.EnrollStatus, "enroll-failed", True)
            finally:
                self.active_proc = None

        self.worker_thread = threading.Thread(target=worker, daemon=True)
        self.worker_thread.start()

    @dbus.service.method(dbus_interface=DEVICE_INTERFACE, in_signature="", out_signature="",
                         sender_keyword="sender")
    def EnrollStop(self, sender=None):
        logging.info(f"EnrollStop requested (sender {sender})")
        self._require_claimant_for_stop(sender)
        was_done = self.operation_done
        self.operation_done = True
        self._stop_current_operation()
        if not was_done:
            GLib.idle_add(self.EnrollStatus, "enroll-unknown-error", True)

    @dbus.service.method(dbus_interface=DEVICE_INTERFACE, in_signature="s", out_signature="",
                         sender_keyword="sender")
    def VerifyStart(self, finger_name, sender=None):
        logging.info(f"VerifyStart for finger: {finger_name} (sender {sender})")
        username = self._require_claim(sender)
        target = self._resolve_user(username, sender)
        uid = target.pw_uid

        fingers = self._list_fingers(username, sender)
        if not fingers:
            raise NoEnrolledPrints()

        selected_finger = finger_name if finger_name != "any" else fingers[0]
        self.VerifyFingerSelected(selected_finger)

        self._stop_current_operation()
        self.stop_requested = False
        self.operation_done = False

        def worker():
            try:
                if self.stop_requested:
                    return
                proc = subprocess.Popen(
                    [SYNA_TOOL, "verify", str(uid), finger_name],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True,
                    bufsize=1
                )
                self.active_proc = proc
                if self.stop_requested:
                    proc.terminate()
                    return

                stderr_lines = []
                def read_stderr():
                    try:
                        for eline in proc.stderr:
                            stderr_lines.append(eline)
                    except Exception:
                        pass
                t_err = threading.Thread(target=read_stderr, daemon=True)
                t_err.start()

                matched = False
                matched_name = selected_finger

                for line in proc.stdout:
                    if self.stop_requested:
                        break
                    line = line.strip()
                    logging.info(f"syna-tool: {line}")
                    if line.startswith("MATCH:"):
                        matched = True
                        matched_name = line.split(":", 1)[1]
                        break
                    elif line.startswith("PROGRESS:"):
                        status_str = line.split(":", 1)[1]
                        GLib.idle_add(self.VerifyStatus, status_str, False)
                    elif line == "NO_MATCH":
                        break

                proc.wait()
                t_err.join(timeout=0.5)
                err = "".join(stderr_lines).strip()
                if err:
                    logging.info(f"syna-tool stderr: {err}")

                if not self.stop_requested and not self.operation_done:
                    self.operation_done = True
                    if matched:
                        GLib.idle_add(self.VerifyFingerMatched, matched_name)
                        GLib.idle_add(self.VerifyStatus, "verify-match", True)
                    else:
                        GLib.idle_add(self.VerifyStatus, "verify-no-match", True)
            except Exception as e:
                logging.error(f"Verify worker error: {e}")
                if not self.operation_done:
                    self.operation_done = True
                    GLib.idle_add(self.VerifyStatus, "verify-unknown-error", True)
            finally:
                self.active_proc = None

        self.worker_thread = threading.Thread(target=worker, daemon=True)
        self.worker_thread.start()

    @dbus.service.method(dbus_interface=DEVICE_INTERFACE, in_signature="", out_signature="",
                         sender_keyword="sender")
    def VerifyStop(self, sender=None):
        logging.info(f"VerifyStop requested (sender {sender})")
        self._require_claimant_for_stop(sender)
        was_done = self.operation_done
        self.operation_done = True
        self._stop_current_operation()
        if not was_done:
            GLib.idle_add(self.VerifyStatus, "verify-unknown-error", True)


class FprintManager(dbus.service.Object):
    def __init__(self, bus_name):
        super().__init__(bus_name, MANAGER_PATH)
        self.dev = FprintDevice(bus_name)

    @dbus.service.method(dbus_interface=MANAGER_INTERFACE, in_signature="", out_signature="ao")
    def GetDevices(self):
        logging.info("Manager.GetDevices called")
        return [dbus.ObjectPath(DEVICE_PATH)]

    @dbus.service.method(dbus_interface=MANAGER_INTERFACE, in_signature="", out_signature="o")
    def GetDefaultDevice(self):
        logging.info("Manager.GetDefaultDevice called")
        return dbus.ObjectPath(DEVICE_PATH)


def main():
    certstore_path = "/etc/synaptics/certstore.bin"
    if not os.path.exists(certstore_path):
        logging.info("No pairing certstore at %s, auto-pairing via %s...", certstore_path, SYNA_TOOL)
        try:
            subprocess.run([SYNA_TOOL, "pair", certstore_path], check=True)
            logging.info("Auto-pairing succeeded: %s", certstore_path)
        except Exception as e:
            logging.error("Auto-pairing failed: %s", e)

    bus = dbus.SystemBus()
    bus_name = dbus.service.BusName(BUS_NAME, bus)
    _mgr = FprintManager(bus_name)
    logging.info("syna-fprintd started and listening on net.reactivated.Fprint")
    loop = GLib.MainLoop()
    try:
        loop.run()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
